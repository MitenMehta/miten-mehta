{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orchestrai-edge-gateway",
  "main": "src/edge_gateway.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ORCHESTRAI_GATEWAY", "class_name": "OrchestrAIGateway" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrchestrAIGateway"] }],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE_INDEX", "index_name": "orchestrai-rag" }],
  "workflows": [{
    "name": "orchestrai-durable-workflow",
    "binding": "ORCHESTRAI_WORKFLOW",
    "class_name": "OrchestrAIWorkflow",
    "limits": { "steps": 25000 }
  }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "agents.orchestraios.com", "custom_domain": true }]
}