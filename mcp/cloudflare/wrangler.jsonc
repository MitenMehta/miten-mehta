{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orchestrai-mcp-server",
  "main": "src/mcp_server.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "OrchestrAIMCP",
        "class_name": "OrchestrAIMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrchestrAIMCP"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "18323656ff8f4815a93f126d99404659"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "mcp.orchestraios.com",
      "custom_domain": true
    }
  ]
}
