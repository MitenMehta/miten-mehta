{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orchestrai-edge-gateway",
  "main": "src/edge_gateway.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "OrchestrAIAgent",
        "class_name": "OrchestrAIAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrchestrAIAgent"]
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "orchestrai-cvo-rag"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orchestrai-sessions",
      "database_id": "947cf9fe-1801-47a5-87d1-353d3921b35a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIT_LOGS",
      "bucket_name": "orchestrai-audit-logs"
    }
  ],
  "workflows": [
    {
      "name": "orchestrai-workflow",
      "binding": "WORKFLOW",
      "class_name": "OrchestrAIWorkflow"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "agents.orchestraios.com",
      "custom_domain": true
    }
  ]
}
