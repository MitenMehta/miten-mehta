{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orchestrai-edge-gateway",
  "main": "orchestrai_edge_gateway.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "OrchestrAIGateway",
        "class_name": "OrchestrAIGateway"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrchestrAIGateway"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "agents.orchestraios.com",
      "custom_domain": true
    }
  ]
}
